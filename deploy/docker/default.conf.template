# Serves the SPA and reverse-proxies the API. ${API_URL} is substituted from
# the env at container start (NGINX_ENVSUBST_FILTER limits substitution to it,
# so nginx's own $variables below are left intact).
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API calls are same-origin (/api/...) and proxied to the API service.
    location /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: unknown routes return index.html for client-side routing.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
